# Copy to .env and fill in real values. Never commit .env.
PORT=8000

# MongoDB connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Use 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Origin allowed by CORS (the deployed client URL)
CLIENT_URL=http://localhost:5173

# Set to true once a payment provider is wired up; false = unlimited credits
BILLING_ENABLED=false

# "production" enables secure/sameSite=none cookies. Leave unset for local dev.
NODE_ENV=

# Firebase service account — Console > Project Settings > Service Accounts >
# Generate new private key. Copy the three values out of the downloaded JSON.
# FIREBASE_PRIVATE_KEY must stay on one line, wrapped in quotes, with literal \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
